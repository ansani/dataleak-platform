# M365 / Microsoft Graph (client credentials flow - app-only)
M365_TENANT_ID=your-tenant-id
M365_CLIENT_ID=your-client-id
M365_CLIENT_SECRET=your-client-secret
M365_USERNAME=your-mailbox@domain.com

# NVIDIA endpoint free (classificazione intent - Nemotron Chat)
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_ENDPOINT_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b

# S/MIME certificato
SMIME_CERT_PATH=./certs/smime.p12
SMIME_CERT_PASSWORD=your-p12-password

# Firma HTML
SIGNATURE_HTML_PATH=./signature/signature.html

# Database stati
DB_PATH=./db/processed.db